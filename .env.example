# --- Database Configuration ---
POSTGRES_DB=tsi_ledger
POSTGRES_USER=tsi_ledger_admin
POSTGRES_PASSWD=<generate-a-strong-password>

# --- Application Configuration ---
TSI_LEDGER_ENV=local

# JWT_SECRET: signs Ops Console operator session tokens (issued by Auth.login
# after email/password verification). Minimum 32 characters.
# Generate with: openssl rand -hex 32
JWT_SECRET=<generate-with-openssl-rand-hex-32>

# Comma-separated list of origins allowed to call the Ops Console API from a browser.
ALLOWED_ORIGINS=http://localhost:8086

# --- Docker Compose port mapping (optional overrides) ---
# docker-compose.yml already defaults to 5438/8086 to avoid colliding with
# other TSI products' 5432-5437/8080-8085 on a shared evaluation host.
# Only set these if 5438/8086 also collide with something on your machine.
# APP_PORT_MAP=8086:8080
# DB_PORT_MAP=5438:5432

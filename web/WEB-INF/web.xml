<?xml version="1.0" ?>
<web-app
		xmlns = "https://jakarta.ee/xml/ns/jakartaee"
		xmlns:xsi = "http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation = "https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
		version = "5.0"
		metadata-complete = "false">

	<display-name>TSI Ledger Service</display-name>

	<!--
      Default Landing Page Configuration
      This ensures that navigating to the root '/' loads index.html automatically.
    -->
	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
	</welcome-file-list>

	<filter>
		<filter-name>TSI_LEDGER</filter-name>
		<filter-class>org.tsicoop.ledger.framework.InterceptingFilter</filter-class>
	</filter>

	<filter-mapping>
		<filter-name>TSI_LEDGER</filter-name>
		<url-pattern>/api/*</url-pattern>
		<dispatcher>REQUEST</dispatcher>
		<dispatcher>FORWARD</dispatcher>
	</filter-mapping>
	<!--
      Server-side gate for the static Ops Console pages: without it they are served
      to any HTTP client and the only login check is client-side JS. Requires a valid
      session cookie (issued by Auth.login) or redirects to the login page.
      login, reset-password and setup/init stay public by design.
    -->
	<filter>
		<filter-name>CONSOLE_AUTH_FILTER</filter-name>
		<filter-class>org.tsicoop.ledger.framework.ConsoleAuthFilter</filter-class>
	</filter>

	<filter-mapping>
		<filter-name>CONSOLE_AUTH_FILTER</filter-name>
		<url-pattern>/console/dashboard.html</url-pattern>
		<dispatcher>REQUEST</dispatcher>
		<dispatcher>FORWARD</dispatcher>
	</filter-mapping>

	<filter-mapping>
		<filter-name>CONSOLE_AUTH_FILTER</filter-name>
		<url-pattern>/console/apps.html</url-pattern>
		<dispatcher>REQUEST</dispatcher>
		<dispatcher>FORWARD</dispatcher>
	</filter-mapping>

	<filter-mapping>
		<filter-name>CONSOLE_AUTH_FILTER</filter-name>
		<url-pattern>/console/entries.html</url-pattern>
		<dispatcher>REQUEST</dispatcher>
		<dispatcher>FORWARD</dispatcher>
	</filter-mapping>

	<filter-mapping>
		<filter-name>CONSOLE_AUTH_FILTER</filter-name>
		<url-pattern>/console/audit.html</url-pattern>
		<dispatcher>REQUEST</dispatcher>
		<dispatcher>FORWARD</dispatcher>
	</filter-mapping>

	<filter-mapping>
		<filter-name>CONSOLE_AUTH_FILTER</filter-name>
		<url-pattern>/console/reports.html</url-pattern>
		<dispatcher>REQUEST</dispatcher>
		<dispatcher>FORWARD</dispatcher>
	</filter-mapping>

	<filter-mapping>
		<filter-name>CONSOLE_AUTH_FILTER</filter-name>
		<url-pattern>/console/accounts.html</url-pattern>
		<dispatcher>REQUEST</dispatcher>
		<dispatcher>FORWARD</dispatcher>
	</filter-mapping>

	<filter-mapping>
		<filter-name>CONSOLE_AUTH_FILTER</filter-name>
		<url-pattern>/console/users.html</url-pattern>
		<dispatcher>REQUEST</dispatcher>
		<dispatcher>FORWARD</dispatcher>
	</filter-mapping>

	<!--
      Jetty's bundled webdefault-ee10.xml sets dirAllowed=true on the "default"
      servlet, so any directory with no welcome file (e.g. /console/setup/) is
      auto-listed. Redeclaring "default" here overrides just that init-param.
    -->
	<servlet>
		<servlet-name>default</servlet-name>
		<servlet-class>org.eclipse.jetty.ee10.servlet.DefaultServlet</servlet-class>
		<init-param>
			<param-name>dirAllowed</param-name>
			<param-value>false</param-value>
		</init-param>
	</servlet>
</web-app>

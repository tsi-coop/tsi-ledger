{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "_func": { "type": "string" },
    "reference_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "description": { "type": "string", "minLength": 1 },
    "posted_at": { "type": "string", "minLength": 1 },
    "lines": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "account_code": { "type": "string", "minLength": 1, "maxLength": 32 },
          "type": { "type": "string", "enum": ["DEBIT", "CREDIT", "debit", "credit"] },
          "amount": { "type": "number", "exclusiveMinimum": 0 }
        },
        "required": ["account_code", "type", "amount"]
      }
    }
  },
  "required": ["_func", "reference_id", "description", "posted_at", "lines"]
}

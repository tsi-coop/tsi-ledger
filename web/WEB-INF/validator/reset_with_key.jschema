{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "_func": { "type": "string" },
    "email": { "type": "string", "minLength": 3, "maxLength": 255 },
    "reset_key": { "type": "string", "minLength": 1, "maxLength": 64 },
    "new_password": { "type": "string", "minLength": 12 }
  },
  "required": ["_func", "email", "reset_key", "new_password"]
}

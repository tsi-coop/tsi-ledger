{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "_func": { "type": "string" },
    "account_type": {
      "type": "string",
      "enum": ["ASSET", "LIABILITY", "EQUITY", "REVENUE", "EXPENSE",
               "asset", "liability", "equity", "revenue", "expense"]
    },
    "include_inactive": { "type": "boolean" }
  },
  "required": ["_func"]
}

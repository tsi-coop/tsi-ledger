{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "_func": { "type": "string" },
    "current_password": { "type": "string", "minLength": 1 },
    "new_password": { "type": "string", "minLength": 12 }
  },
  "required": ["_func", "current_password", "new_password"]
}

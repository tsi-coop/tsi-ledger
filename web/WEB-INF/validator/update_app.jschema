{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "_func": { "type": "string" },
    "app_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "can_manage_accounts": { "type": "boolean" }
  },
  "required": ["_func", "app_id", "can_manage_accounts"]
}
